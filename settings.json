{
  "rules": {
    "dispatch": {
      "InputDispatchDominationRule": true,
      "MemoryPressureDispatchRule": true,
      "DispatchCostPruningRule": true,
      "DispatchCycleRule": true
    },
    "bufferize": {
      "MemSpaceMismatchInplaceRule": true,
      "CommutativeInplaceSymmetryRule": true,
      "PeakMemoryPruningRule": true,
      "BufferizeCostPruningRule": true
    },
    "malloc": {
      "OffsetMonotoneRule": true,
      "IdMaxSymmetryRule": true,
      "HMinBoundRule": true
    },
    "cache": {},
    "extract": {
      "InfiniteCostSkipRule": true,
      "CachedENodeValidityRule": true,
      "MissingCachedEClassRule": true,
      "ExtractorCycleStepRule": true,
      "ExtractorJacksonCarlierRule": true
    },
    "enode": {
      "MemCapENodeDominationRule": true,
      "FasterEquivalentENodeDominationRule": true
    }
  }
}
